# آدرس اتصال به دیتابیس PostgreSQL
# مثال محلی: postgresql://postgres:password@localhost:5432/nemati_store
# مثال سرویس ابری (مثل Neon, Supabase, Railway): از پنل همان سرویس کپی کنید
DATABASE_URL="postgresql://user:password@localhost:5432/nemati_store"

# کلید رمزنگاری NextAuth — یک رشته تصادفی طولانی بسازید
# با این دستور در ترمینال یک مقدار امن می‌سازید: openssl rand -base64 32
NEXTAUTH_SECRET="یک-رشته-تصادفی-طولانی-اینجا"

# آدرس کامل سایت شما (در حالت محلی همین مقدار را نگه دارید)
NEXTAUTH_URL="http://localhost:3000"

# اطلاعات اولین Super Admin — فقط هنگام اجرای دستور seed استفاده می‌شود
SUPER_ADMIN_EMAIL="admin@nematistor.af"
SUPER_ADMIN_PASSWORD="یک-رمز-عبور-قوی-بسازید"
